/* settlement.wxss */
.container {
  padding: 30rpx;
  background: #f8f8f8;
  min-height: 100vh;
}

.room-info {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 140rpx;
}

.room-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.rate-info {
  font-size: 28rpx;
  color: #666;
}

.rate-value {
  font-weight: bold;
  color: #1890ff;
  font-size: 32rpx;
}

.settlement-section {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
}

.section-title {
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.settlement-table {
  width: 100%;
}

.table-header {
  display: flex;
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 20rpx 0;
  margin-bottom: 10rpx;
}

.header-cell {
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
  text-align: center;
}

.header-cell.rank {
  width: 15%;
}

.header-cell.player {
  width: 40%;
  text-align: left;
  padding-left: 20rpx;
}

.header-cell.score,
.header-cell.rate-score {
  width: 22.5%;
}

.table-body {
  width: 100%;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  display: flex;
  align-items: center;
}

.rank-cell {
  width: 15%;
  justify-content: center;
}

.rank-number {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #e8e8e8;
  color: #666;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  font-weight: bold;
}

.player-cell {
  width: 40%;
  padding-left: 20rpx;
}

.player-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.player-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-cell,
.rate-score-cell {
  width: 22.5%;
  justify-content: center;
}

.score-value,
.rate-score-value {
  font-size: 32rpx;
  font-weight: bold;
}