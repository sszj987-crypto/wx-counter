/* settlement.wxss */
page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

.container {
  flex: 1;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 房间信息样式 */
.room-info {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.room-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rate-info {
  font-size: 28rpx;
  color: #666666;
  margin-left: 20rpx;
  white-space: nowrap;
  display: flex;
  align-items: center;
}

.rate-value {
  color: #1890ff;
  font-weight: bold;
}

/* 结算部分样式 */
.settlement-section {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex: 1;
}

.section-title {
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

/* 表格样式 */
.settlement-table {
  width: 100%;
}

.table-header {
  display: flex;
  background-color: #fafafa;
  padding: 20rpx 0;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.header-cell {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #666666;
}

.header-cell.rank {
  flex: 0.6;
}

.header-cell.player {
  flex: 1.5;
}

.header-cell.score {
  flex: 0.8;
}

.header-cell.rate-score {
  flex: 0.8;
}

.table-body {
  margin-top: 10rpx;
}

.table-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  align-items: center;
  min-height: 80rpx; /* 统一行高 */
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx; /* 统一最小高度 */
}

.table-cell.rank-cell {
  flex: 0.6;
  display: flex;
  justify-content: center;
  align-items: center;
}

.table-cell.player-cell {
  flex: 1.5;
  display: flex;
  align-items: center;
}

.table-cell.score-cell {
  flex: 0.8;
}

.table-cell.rate-score-cell {
  flex: 0.8;
}

/* 排名样式 */
.rank-number {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #666666;
  background-color: #f0f0f0;
}

/* 玩家头像样式 */
.player-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.player-name {
  font-size: 28rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分数样式 */
.score-value,
.rate-score-value {
  font-size: 30rpx;
  font-weight: bold;
}

/* 操作按钮样式 */
.action-buttons {
  margin-top: 40rpx;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 0 20rpx 20rpx;
}

.new-game-btn,
.home-btn {
  flex: 1;
}

.new-game-btn {
  background-color: #52c41a;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 25rpx 0;
  margin: 0;
  box-shadow: 0 2rpx 10rpx rgba(82, 196, 26, 0.2);
}

.new-game-btn:active {
  background-color: #73d13d;
}

.home-btn {
  background-color: #ffffff;
  color: #666666;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 25rpx 0;
  margin: 0;
  border: 1rpx solid #d9d9d9;
}

.home-btn:active {
  background-color: #f5f5f5;
}

/* 加载状态样式 */
.new-game-btn[loading="true"] {
  color: transparent;
}

/* 适配不同屏幕大小 */
@media (min-width: 768rpx) {
  .container {
    max-width: 600rpx;
    margin: 0 auto;
  }
}