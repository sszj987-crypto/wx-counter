<!--settlement.wxml-->
<navigation-bar title="房间结算" back="{{true}}" homeButton="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="container">
  
  <!-- 房间信息 -->
  <view class="room-info">
    <view class="room-name">{{roomName}}</view>
    <view class="rate-info">计算倍率: <text class="rate-value">{{rate || 1}}</text>倍</view>
  </view>

  <!-- 结算表格 -->
  <view class="settlement-section">
    <view class="section-title">
      <view class="title-text">结算结果</view>
    </view>

    <view class="settlement-table">
      <view class="table-header">
        <view class="header-cell rank">排名</view>
        <view class="header-cell player">玩家</view>
        <view class="header-cell score">得分</view>
        <view class="header-cell rate-score">倍率分</view>
      </view>

      <view class="table-body">
        <view class="table-row" wx:for="{{players}}" wx:key="openId">
          <view class="table-cell rank-cell">
            <view class="rank-number" wx:if="{{index === 0}}" style="background-color: #ffd700; color: #fff;">{{index + 1}}</view>
            <view class="rank-number" wx:elif="{{index === 1}}" style="background-color: #c0c0c0; color: #fff;">{{index + 1}}</view>
            <view class="rank-number" wx:elif="{{index === 2}}" style="background-color: #cd7f32; color: #fff;">{{index + 1}}</view>
            <view class="rank-number" wx:else>{{index + 1}}</view>
          </view>
          
          <view class="table-cell player-cell">
            <image class="player-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
            <view class="player-name">{{item.nickName}}</view>
          </view>
          
          <view class="table-cell score-cell">
            <view class="score-value" style="color: {{item.score >= 0 ? '#52c41a' : '#ff4d4f'}}">{{item.score}}</view>
          </view>
          
          <view class="table-cell rate-score-cell">
            <view class="rate-score-value" style="color: {{item.rateScore >= 0 ? '#52c41a' : '#ff4d4f'}}">{{item.rateScore}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>