/* score-details.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.room-info {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 120rpx;
}

.room-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  line-height: 1.5;
}

.records-section {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  position: relative;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.record-count {
  font-size: 24rpx;
  color: #999;
}

.records-list {
  border-radius: 8rpx;
  overflow: hidden;
}

.records-container {
  padding-bottom: 20rpx;
  padding-right: 30rpx; /* 为滚动条留出空间 */
}

.records-empty {
  padding: 100rpx 0;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 300rpx;
}

.record-time {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  padding: 40rpx 0;
}

.record-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-header {
  margin-bottom: 15rpx;
}

.record-content {
  display: flex;
  align-items: center;
  width: 100%;
}

.record-player-info {
  display: flex;
  align-items: center;
  flex: 1; /* 占据大部分空间 */
  max-width: calc(100% - 120rpx); /* 为分数部分留出足够空间 */
}

.player-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.player-name {
  font-size: 28rpx;
  color: #333;
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  font-size: 32rpx;
  color: #999;
  margin: 0 20rpx;
}

.record-score {
  margin-left: 20rpx;
  flex-shrink: 0; /* 防止分数部分被压缩 */
  min-width: 80rpx; /* 确保分数有足够的显示空间 */
  text-align: right; /* 分数右对齐 */
}

.score-value {
  font-size: 36rpx;
  font-weight: bold;
}