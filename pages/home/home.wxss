/* home.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

.container {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.welcome {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.main-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.start-button {
  width: 90%;
  height: 180rpx;
  background: linear-gradient(135deg, #1296db, #0e7bb8);
  border-radius: 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 150, 219, 0.3);
  border: none !important;
  margin: 0 !important;
  padding: 0 !important;
  font-size: 36rpx;
  color: white;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.start-button::after {
  border: none !important;
  border-radius: 60rpx !important;
  width: 100% !important;
  height: 100% !important;
  transform: scale(1) !important;
}

/* 确保微信默认样式不会覆盖我们的自定义样式 */
.main-content button {
  width: 90% !important;
}

.loading-tip {
  text-align: center;
  margin-top: 40rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #666;
}
