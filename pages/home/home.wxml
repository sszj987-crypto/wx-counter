<!--home.wxml-->
<navigation-bar title="可乐计分器" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<view class="container">
  <view class="header">
    <view class="welcome">欢迎使用可乐计分器</view>
    <view class="subtitle">简单、快捷、实时同步</view>
  </view>

  <view class="main-content">
    <button class="start-button" bindtap="startMultiPlayer" disabled="{{!hasUserInfo}}">
      <view>开始计分 - 多人模式</view>
      <view class="button-note">所有玩家自己计分</view>
    </button>
  </view>
</view>
