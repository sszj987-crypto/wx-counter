<!--home.wxml-->
<navigation-bar title="可乐计分器" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<view class="container">
  <view class="header">
    <view class="welcome">欢迎使用可乐计分器</view>
    <view class="subtitle">简单、快捷、实时同步</view>
  </view>

  <view class="main-content">
    <!-- 进入房间按钮 - 仅在存在活跃房间时显示 -->
    <button class="start-button enter-room-button" 
            bindtap="enterExistingRoom" 
            disabled="{{!hasUserInfo}}" 
            wx:if="{{activeRoom}}">
      <view>{{activeRoom.status === 'settling' ? '查看结算' : '进入房间'}}{{activeRoom.roomNumber}}</view>
      <view class="button-note">{{activeRoom.status === 'settling' ? '结算记录同步中' : '进入已有房间'}}</view>
    </button>
    
    <!-- 开始计分按钮 - 始终显示 -->
    <button class="start-button" 
            bindtap="startMultiPlayer" 
            disabled="{{!hasUserInfo}}">
      <view>开始计分 - 多人模式</view>
      <view class="button-note">创建新房间</view>
    </button>
  </view>
</view>
