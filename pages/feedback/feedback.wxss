/* feedback.wxss */
page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

.container,
.page-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  box-sizing: border-box;
}

.form-section {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.form-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.form-desc {
  font-size: 28rpx;
  color: #666;
}

.form-item {
  margin-bottom: 60rpx;
}

.form-label {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.textarea-container {
  border: 2rpx solid #e9ecef;
  border-radius: 16rpx;
  background: white;
  padding: 0;
  overflow: hidden;
}

.content-textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 30rpx;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  box-sizing: border-box;
  resize: none;
  line-height: 1.6;
}

.content-textarea::placeholder {
  color: #999;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 0;
  padding: 0 30rpx 15rpx;
}

.submit-section {
  margin-bottom: 60rpx;
  display: flex;
  justify-content: center;
}

.submit-button {
  width: 90%;
  height: 100rpx;
  background: linear-gradient(135deg, #1296db, #0e7bb8);
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none !important;
  margin: 0 !important;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.3);
}

.submit-button::after {
  border: none !important;
  border-radius: 50rpx !important;
  width: 100% !important;
  height: 100% !important;
  transform: scale(1) !important;
}

/* 禁用状态 */
.submit-button[disabled] {
  background: #ccc;
  box-shadow: none;
}

/* 确保微信默认样式不会覆盖我们的自定义样式 */
.submit-section button {
  width: 90% !important;
}

/* 反馈说明部分 - 放在页面最底部，增加透明度 */
.tips-section {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  margin-top: auto;
  opacity: 0.7;
}

.section-divider {
  height: 1rpx;
  background-color: #e9ecef;
  margin-bottom: 20rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.tips-list {
  text-align: center;
}

.tip-item {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.footer {
  text-align: center;
  padding: 20rpx 0;
  margin-top: 20rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #999;
}