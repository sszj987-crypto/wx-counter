<!--room.wxml-->
<navigation-bar title="可乐计分器" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="container {{largeTextEnabled ? 'large-text' : ''}}">
  <view class="room-top-bar" wx:if="{{roomData && !isCreating}}">
    <view class="settings-button" bindtap="toggleSettingsPanel">
      <text class="settings-icon">⚙️</text>
      <text class="settings-label">设置</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{isCreating}}">
    <view class="loading-text">正在创建房间...</view>
  </view>

  <!-- 房间信息 -->
  <view class="room-info" wx:if="{{roomData && !isCreating}}">
    <view class="room-header">
      <view class="room-name">房间{{roomData.roomNumber}}</view>
    </view>

    <!-- 小程序码和邀请 -->
    <view class="invite-section">
      <button class="share-button" open-type="share">
        <view class="share-icon">📤</view>
        <view class="share-text">邀请好友</view>
      </button>
      <button class="qrcode-button" bindtap="exitRoom">
        <view class="qrcode-icon">🚪</view>
        <view class="qrcode-text">退出房间</view>
      </button>
      
    </view>
  </view>

  <view class="settings-overlay" wx:if="{{showSettingsPanel}}" bindtap="closeSettingsPanel"></view>
  <view class="settings-panel {{largeTextEnabled ? 'large-text' : ''}}" wx:if="{{showSettingsPanel}}" catchtap="">
    <view class="setting-option">
      <text class="switch-label">房费</text>
      <switch 
        checked="{{isRoomFeeEnabled}}" 
        bindchange="toggleRoomFee"
        type="switch"
      />
    </view>
    <view class="setting-option">
      <text class="switch-label">大字体模式</text>
      <switch 
        checked="{{largeTextEnabled}}" 
        bindchange="toggleLargeText"
        type="switch"
      />
    </view>
  </view>

  <!-- 玩家列表 -->
  <view class="players-section" wx:if="{{roomData && !isCreating}}">
    <view class="section-title">
      <view class="title-text">玩家列表</view>
      <view class="player-count">{{roomData.players.length}}人</view>
    </view>

    <view class="players-table">
      <!-- 固定表头 -->
      <view class="table-header">
        <view class="header-cell player">玩家</view>
        <view class="header-cell score">得分</view>
        <view class="header-cell action">操作</view>
      </view>
      
      <!-- 可滚动的表格内容 -->
      <scroll-view class="players-scroll" scroll-y="true">
        <view class="table-body">
          <view class="table-row" wx:for="{{roomData.players}}" wx:key="openId">
            <view class="table-cell player-cell">
              <view class="player-info">
                <view class="player-name-wrapper">
                  <view class="player-name {{item.openId === currentUserOpenId ? 'clickable' : ''}} {{item.nickName === '房费' ? 'room-fee-name' : ''}}" bindtap="onPlayerNameTap" data-openid="{{item.openId}}">{{item.nickName}}</view>
                  <view class="self-tag" wx:if="{{item.openId === currentUserOpenId}}">(自己)</view>
                </view>
              </view>
            </view>
            
            <view class="table-cell score-cell">
              <view class="score-value" style="color: {{item.score >= 0 ? '#52c41a' : '#ff4d4f'}}">
                {{item.score}}
              </view>
            </view>
            
            <view class="table-cell action-cell">
              <button wx:if="{{item.openId !== currentUserOpenId}}" 
                      class="transfer-button" 
                      data-player="{{item}}" 
                      bindtap="showTransferModal">
                给分
              </button>
              <button wx:else 
                      class="transfer-button batch-button" 
                      bindtap="showBatchTransferModal">
                批量给分
              </button>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 房费设置弹窗 -->
  <view class="modal-overlay" wx:if="{{roomFeeSettingsModal.show}}" catchtouchmove="true" bindtap="hideRoomFeeSettings">
    <view class="modal-content" catchtap="onRoomFeeSettingsTap">
      <view class="modal-header">
        <view class="modal-title">房费设置</view>
        <view class="modal-close" bindtap="hideRoomFeeSettings">×</view>
      </view>
      
      <view class="room-fee-settings">
        <view class="room-fee-status" wx:if="{{isRoomFeeEnabled}}">
          <view class="room-fee-status-header">
            <text class="room-fee-status-label">已收取房费</text>
            <text class="room-fee-status-value">{{roomFeeCollected}}</text>
          </view>
          <view class="room-fee-withdraw-section" wx:if="{{roomFeeCollected > 0}}">
            <view class="room-fee-withdraw-input-group">
              <text class="room-fee-withdraw-label">取回金额</text>
              <input 
                class="room-fee-withdraw-input"
                type="number" 
                placeholder="全部取回" 
                value="{{roomFeeWithdrawAmount}}"
                bindinput="onRoomFeeWithdrawInput"
              />
            </view>
            <button class="room-fee-withdraw-btn" bindtap="withdrawRoomFee">取回房费</button>
          </view>
        </view>
        
        <view class="setting-input-group">
          <text class="setting-input-label">房费总额（元）</text>
          <input 
            class="setting-input"
            type="number" 
            placeholder="100" 
            value="{{roomFeeSettingsModal.total}}"
            bindinput="onRoomFeeTotalInput"
          />
        </view>
        
        <view class="setting-input-group">
          <text class="setting-input-label">满X元</text>
          <input 
            class="setting-input"
            type="number" 
            placeholder="10" 
            value="{{roomFeeSettingsModal.fullX}}"
            bindinput="onRoomFeeFullXInput"
          />
        </view>
        
        <view class="setting-input-group">
          <text class="setting-input-label">抽Y元</text>
          <input 
            class="setting-input"
            type="number" 
            placeholder="1" 
            value="{{roomFeeSettingsModal.drawY}}"
            bindinput="onRoomFeeDrawYInput"
          />
        </view>
        
        <view class="setting-rule">
          <text class="setting-rule-text">规则：每次给分≥满X元时，从给分中抽取Y元作为房费</text>
          <text class="setting-rule-text">房费达到总额后不再抽取</text>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="modal-button cancel" bindtap="hideRoomFeeSettings">取消</button>
        <button class="modal-button confirm" bindtap="saveRoomFeeSettings">保存</button>
      </view>
    </view>
  </view>

  <!-- 结算房间弹窗 -->
  <view class="modal-overlay" wx:if="{{settlementModal.show}}" bindtap="hideSettlementModal">
    <view class="modal-content" catchtap="">
      <view style="padding: 40rpx 30rpx 30rpx; text-align: center; box-sizing: border-box;">
        <text style="display: block; font-size: 36rpx; font-weight: bold; margin-bottom: 30rpx;">输入计算倍率</text>
        <input 
          type="number" 
          placeholder="1" 
          value="{{settlementModal.rate}}"
          bindinput="onRateInput" 
          focus="{{settlementModal.show}}"
          style="width: 100%; height: 80rpx; border: 1rpx solid #ddd; border-radius: 8rpx; padding: 0 20rpx; font-size: 32rpx; box-sizing: border-box;"
          confirm-type="done"
          maxlength="5"/>
      </view>
      
      <view class="modal-footer">
        <button class="modal-button cancel" bindtap="hideSettlementModal">取消</button>
        <button class="modal-button confirm" bindtap="confirmSettlement" disabled="{{isSettling}}">确定</button>
      </view>
    </view>
  </view>
</view>

<!-- 底部操作按钮 -->
<view class="bottom-actions {{largeTextEnabled ? 'large-text' : ''}}" wx:if="{{roomData && !isCreating}}">
  <button class="action-button detail-button" bindtap="navigateToScoreDetails">
    给分详情
  </button>
  <button class="action-button settle-button" bindtap="showSettlementModal">
    结算房间
  </button>
</view>

<!-- 批量给分弹窗 -->
<view class="modal-overlay {{largeTextEnabled ? 'large-text' : ''}}" wx:if="{{batchTransferModal.show}}" catchtouchmove="true">
  <view class="batch-modal-content" catchtap="" style="transform: translateY(-{{batchTransferModal.keyboardHeight ? batchTransferModal.keyboardHeight * 0.2 : 0}}px); transition: transform 0.2s;">
    <view class="modal-header">
      <view class="modal-title">批量给分</view>
      <view class="modal-close" bindtap="hideBatchTransferModal">×</view>
    </view>
    
    <scroll-view class="batch-list" scroll-y="{{batchTransferModal.players.length > 4}}" style="max-height: {{batchTransferModal.players.length > 4 ? '50vh' : 'auto'}};">
      <view class="batch-item" wx:for="{{batchTransferModal.players}}" wx:key="openId">
        <view class="batch-player-name">{{item.nickName}}</view>
        <input 
          class="batch-input"
          type="number" 
          placeholder="0" 
          value="{{item.score}}"
          data-index="{{index}}"
          bindinput="onBatchScoreInput"
          bindfocus="onBatchInputFocus"
          bindblur="onBatchInputBlur"
          adjust-position="{{false}}"
          cursor-spacing="60"
        />
      </view>
    </scroll-view>
    
    <view class="modal-footer">
      <button class="modal-button cancel" bindtap="hideBatchTransferModal" disabled="{{isTransferring}}">取消</button>
      <button class="modal-button confirm" bindtap="confirmBatchTransfer" disabled="{{isTransferring}}">
        {{isTransferring ? '处理中...' : '确认'}}
      </button>
    </view>
  </view>
</view>

<!-- 给分弹窗 -->
<view class="modal-overlay {{largeTextEnabled ? 'large-text' : ''}}" wx:if="{{transferModal.show}}" catchtouchmove="true">
  <view class="modal-content" catchtap="" style="transform: translateY(-{{transferModal.keyboardHeight ? transferModal.keyboardHeight * 0.2 : 0}}px); transition: transform 0.2s;">
    <view class="modal-header">
      <view class="modal-title">给 {{transferModal.targetPlayer && transferModal.targetPlayer.nickName ? transferModal.targetPlayer.nickName : '玩家'}} 加分</view>
      <view class="modal-close" bindtap="hideTransferModal">×</view>
    </view>
    
    <!-- 简化的输入区域 -->
    <view style="padding: 30rpx; box-sizing: border-box;">
      <text style="display: block; margin-bottom: 20rpx;">请输入分数：</text>
      <input 
        id="scoreInput"
        type="number" 
        placeholder="0" 
        value="{{transferModal.score}}"
        bindinput="onScoreInput" 
        focus="{{transferModal.focusTrigger}}"
        adjust-position="{{false}}"
        bindfocus="onTransferInputFocus"
        bindblur="onTransferInputBlur"
        cursor-spacing="120"
        style="width: 100%; height: 80rpx; border: 1rpx solid #ddd; border-radius: 8rpx; padding: 0 20rpx; font-size: 32rpx; box-sizing: border-box;"
        confirm-type="done"
        cursor="10"/>
    </view>
    
    <view class="modal-footer">
      <button class="modal-button cancel" bindtap="hideTransferModal" disabled="{{isTransferring}}">取消</button>
      <button class="modal-button confirm" bindtap="confirmTransfer" disabled="{{isTransferring}}">
        {{isTransferring ? '处理中...' : '确认'}}
      </button>
    </view>
  </view>
</view>
