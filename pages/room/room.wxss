/* room.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

.container {
  flex: 1;
  padding: 40rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx); /* 添加底部安全区域避让 */
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

.room-info {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.room-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.room-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.invite-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20rpx;
}

.qrcode-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  border: 2rpx solid #f0f0f0;
}

.qrcode-tip {
  font-size: 20rpx;
  color: #666;
  margin-top: 10rpx;
}

.share-button, .qrcode-button {
  flex: 1;
  min-width: 140rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
  padding: 0;
}

.share-button::after, .qrcode-button::after {
  border: none;
}

.share-button {
  background: linear-gradient(135deg, #28a745, #1e7e34);
}

.qrcode-button {
  background: linear-gradient(135deg, #28a745, #20c997);
}

.share-icon, .qrcode-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.share-text, .qrcode-text {
  font-size: 24rpx;
  color: white;
}

/* 台位/茶水开关样式 */
.tea-service-switch {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8f9fa;
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
  margin-top: 10rpx;
}

.switch-label {
  font-size: 28rpx;
  color: #333;
}

.players-section {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #e9ecef;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.player-count {
  font-size: 24rpx;
  color: #666;
  background: #e9ecef;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.players-table {
  background: white;
  overflow: hidden;
}

/* 玩家列表滚动区域样式 */
.players-scroll {
  width: 100%;
  height: 400rpx;
  overflow-x: hidden;
  background: white;
}

/* 当玩家数量超过6人时，添加滚动条样式 */
.players-scroll::-webkit-scrollbar {
  width: 4rpx;
}

.players-scroll::-webkit-scrollbar-track {
  background: #f1f1f1;
}

.players-scroll::-webkit-scrollbar-thumb {
  background: #888;
  border-radius: 2rpx;
}

.players-scroll::-webkit-scrollbar-thumb:hover {
  background: #555;
}

/* 保证表头和表格主体的列宽一致 */
.table-header, .table-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 保证表头和表格主体的内边距一致 */
.header-cell, .table-cell {
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.header-cell.player {
  flex: 2;
  justify-content: flex-start;
  position: relative;
}

.header-cell.player::before {
  content: '';
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  display: inline-block;
}

.header-cell.score {
  flex: 1;
  justify-content: center;
}

.header-cell.action {
  flex: 1;
  justify-content: center;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell.player-cell {
  flex: 2;
  justify-content: flex-start;
  padding-left: 20rpx;
}

.player-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.player-info {
  flex: 1;
  min-width: 0;
}

.player-name {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 4rpx;
  text-decoration-thickness: 1rpx;
  text-decoration-color: #07c160;
}

.table-cell.score-cell {
  flex: 1;
  justify-content: center;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.table-cell.action-cell {
  flex: 1;
  justify-content: center;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.score-value {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
}

/* 为操作列的按钮添加适当的宽度和样式 */
.transfer-button {
  width: 100%;
  max-width: 120rpx;
  height: 50rpx;
  background: #28a745;
  color: white;
  border-radius: 25rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.transfer-button[disabled] {
  background: #ccc;
  color: #999;
}

.transfer-button::after {
  border: none;
}

/* 弹窗通用样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-content {
  background: white;
  border-radius: 16rpx;
  width: 80%;
  max-width: 500rpx;
  overflow: hidden;
  margin-top: -40rpx;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  padding: 0 10rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-button {
  flex: 1;
  border-radius: 0;
  border: none;
  height: 90rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-button::after {
  border: none;
}

.modal-button.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-button.confirm {
  background: #28a745;
  color: white;
}

/* 二维码弹窗样式 */
.qrcode-modal {
  width: 80%;
  max-width: 500rpx;
  text-align: center;
}

.qrcode-display {
  padding: 30rpx;
}

.large-qrcode {
  width: 100%;
  height: 400rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #f0f0f0;
  padding: 20rpx;
}

.qrcode-instruction {
  font-size: 28rpx;
  color: #666;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.room-id-display {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.room-id-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

.room-id-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #28a745;
  padding: 0 20rpx;
  background-color: #fff;
  border-radius: 4rpx;
  min-width: 200rpx;
}

.qrcode-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 开发环境提示信息样式 */
.qrcode-env-info {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 15rpx;
  background: #f5f5f5;
  padding: 10rpx;
  border-radius: 8rpx;
  line-height: 36rpx;
}

/* 底部操作按钮 */
.bottom-actions {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.action-button {
  flex: 1;
  margin: 0 10rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.detail-button {
  background-color: #fff;
  color: #28a745;
  border: 1rpx solid #28a745;
}

.settle-button {
  background-color: #28a745;
  color: #fff;
}

.modal-body {
  padding: 40rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.score-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: white;
}

.current-score {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.modal-btn {
  flex: 1;
  height: 100rpx;
  border: none;
  margin: 0;
  padding: 0;
  font-size: 32rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel,
.cancel-btn {
  background: #f8f9fa;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn.confirm,
.confirm-btn {
  background: #28a745;
  color: white;
}
