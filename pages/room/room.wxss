/* room.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

.container {
  flex: 1;
  padding: 40rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 150rpx); /* 为底部操作按钮留出空间 */
  display: flex;
  flex-direction: column;
}

.players-section {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.players-scroll {
  width: 100%;
  flex: 1;
  overflow-x: hidden;
  background: white;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

.room-info {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.room-top-bar {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.room-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.room-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  width: 100%;
}

.invite-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20rpx;
}

.share-button, .qrcode-button {
  flex: 1;
  min-width: 140rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
  padding: 0;
}

.share-button::after, .qrcode-button::after {
  border: none;
}

.share-button {
  background: #28a745;
}

.qrcode-button {
  background: #07c160;
}

.share-icon, .qrcode-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.share-text, .qrcode-text {
  font-size: 24rpx;
  color: white;
}

/* 房费开关样式 */
.settings-button {
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 1rpx solid #e9ecef;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  min-width: 0;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.settings-icon {
  font-size: 30rpx;
}

.settings-label {
  font-size: 28rpx;
  color: #333;
  margin-left: 8rpx;
}

.settings-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9998;
}

.settings-panel {
  position: fixed;
  top: 210rpx;
  right: 40rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  z-index: 9999;
  min-width: 260rpx;
}

.setting-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 10rpx;
}

.setting-option + .setting-option {
  border-top: 1rpx solid #f0f0f0;
}

.setting-option-button {
  cursor: pointer;
  padding: 16rpx 10rpx;
}

.setting-option-button:active {
  background: #f5f5f5;
}

.setting-button-label {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 500;
}

.switch-label {
  font-size: 28rpx;
  color: #333;
}

.room-fee-settings {
  padding: 20rpx;
  box-sizing: border-box;
}

.room-fee-status {
  background: #f0f9ff;
  padding: 16rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.room-fee-status-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.room-fee-status-label {
  font-size: 24rpx;
  color: #666;
}

.room-fee-status-value {
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
}

.room-fee-withdraw-section {
  border-top: 1rpx solid #e0e0e0;
  padding-top: 14rpx;
}

.room-fee-withdraw-input-group {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.room-fee-withdraw-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 12rpx;
  white-space: nowrap;
}

.room-fee-withdraw-input {
  flex: 1;
  height: 56rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 14rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.room-fee-withdraw-btn {
  width: 100%;
  height: 64rpx;
  font-size: 26rpx;
  background: #07c160;
  color: white;
  border-radius: 8rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.room-fee-withdraw-btn::after {
  border: none;
}

.setting-input-group {
  margin-bottom: 20rpx;
}

.setting-input-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.setting-input {
  width: 100%;
  height: 68rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.setting-rule {
  background: #f8f9fa;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
}

.setting-rule-text {
  display: block;
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.setting-rule-text + .setting-rule-text {
  margin-top: 8rpx;
}

.large-text .room-name {
  font-size: 48rpx;
}

.large-text .share-text,
.large-text .qrcode-text {
  font-size: 34rpx;
}

.large-text .switch-label {
  font-size: 38rpx;
}

.large-text .room-top-bar {
  height: 108rpx;
}

.large-text .settings-button {
  height: 78rpx;
  padding: 0 36rpx;
  border-radius: 39rpx;
}

.large-text .settings-icon {
  font-size: 38rpx;
}

.large-text .settings-label {
  font-size: 36rpx;
}

.large-text .section-title {
  padding: 38rpx 44rpx;
}

.large-text .title-text {
  font-size: 42rpx;
}

.large-text .player-count {
  font-size: 34rpx;
}

.large-text .header-cell {
  font-size: 34rpx;
}

.large-text .player-name {
  font-size: 38rpx;
}

.large-text .score-value {
  font-size: 42rpx;
}

.large-text .transfer-button {
  height: 68rpx;
  border-radius: 34rpx;
  font-size: 36rpx;
  max-width: 160rpx;
}

.large-text .modal-title {
  font-size: 42rpx;
}

.large-text .modal-button {
  font-size: 36rpx;
}

.large-text .action-button {
  font-size: 40rpx;
  height: 108rpx;
  line-height: 108rpx;
}

.players-section {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #e9ecef;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.player-count {
  font-size: 24rpx;
  color: #666;
  background: #e9ecef;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.players-table {
  background: white;
  overflow: hidden;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 玩家列表滚动区域样式 */
.players-scroll {
  width: 100%;
  flex: 1;
  overflow-x: hidden;
  background: white;
}

/* 当玩家数量超过6人时，添加滚动条样式 */
.players-scroll::-webkit-scrollbar {
  width: 4rpx;
}

.players-scroll::-webkit-scrollbar-track {
  background: #f1f1f1;
}

.players-scroll::-webkit-scrollbar-thumb {
  background: #888;
  border-radius: 2rpx;
}

.players-scroll::-webkit-scrollbar-thumb:hover {
  background: #555;
}

/* 保证表头和表格主体的列宽一致 */
.table-header, .table-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 表格主体样式 */
.table-body {
  flex: 1;
}

/* 保证表头和表格主体的内边距一致 */
.header-cell, .table-cell {
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.header-cell.player {
  flex: 2;
  justify-content: flex-start;
  position: relative;
  padding-left: 32rpx;
}

/* 移除占位伪元素，因为不再显示头像 */
.header-cell.player::before {
  display: none;
}

.header-cell.score {
  flex: 1;
  justify-content: center;
}

.header-cell.action {
  flex: 1;
  justify-content: center;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell.player-cell {
  flex: 2;
  justify-content: flex-start;
  padding-left: 32rpx;
}

.player-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.player-info {
  flex: 1;
  min-width: 0;
}

.player-name {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: inline-block;
}

.player-name.clickable {
  cursor: pointer;
  border-bottom: 2rpx solid #07c160;
  padding-bottom: 4rpx;
}

.player-name.room-fee-name {
  cursor: pointer;
  border-bottom: 2rpx solid #07c160;
  padding-bottom: 4rpx;
}

.table-cell.score-cell {
  flex: 1;
  justify-content: center;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.table-cell.action-cell {
  flex: 1;
  justify-content: center;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.score-value {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
}

/* 为操作列的按钮添加适当的宽度和样式 */
.transfer-button {
  width: 100%;
  max-width: 120rpx;
  height: 50rpx;
  background: #28a745;
  color: white;
  border-radius: 25rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.transfer-button[disabled] {
  background: #ccc;
  color: #999;
}

.transfer-button::after {
  border: none;
}

/* 弹窗通用样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-content {
  background: white;
  border-radius: 16rpx;
  width: 80%;
  max-width: 500rpx;
  overflow: hidden;
  /* margin-top: -40rpx; */
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  padding: 0 10rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-button {
  flex: 1;
  border-radius: 0;
  border: none;
  height: 90rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-button::after {
  border: none;
}

.modal-button.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-button.confirm {
  background: #28a745;
  color: white;
}

.room-id-display {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.room-id-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

.room-id-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #28a745;
  padding: 0 20rpx;
  background-color: #fff;
  border-radius: 4rpx;
  min-width: 200rpx;
}

/* 批量给分样式 */
.batch-button {
  background: #28a745; /* 统一使用绿色 */
}

.player-name-wrapper {
  display: flex;
  align-items: center;
}

.self-tag {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.batch-modal-content {
  background: white;
  border-radius: 16rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  z-index: 9999;
}

.batch-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
  box-sizing: border-box;
  min-height: 500rpx;
  max-height: 50vh;
}

.batch-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
}

.batch-item:last-child {
  border-bottom: none;
}

.batch-player-name {
  flex: 1;
  font-size: 28rpx;
  color: #000;
  margin-right: 20rpx;
  overflow: visible;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  font-weight: 500;
}

.batch-input {
  width: 140rpx;
  height: 60rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 10rpx;
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
  background: #fff;
  color: #000;
}

/* 底部操作按钮 */
.bottom-actions {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 20rpx;
  left: 0;
  right: 0;
  z-index: 100;
}

.action-button {
  flex: 1;
  margin: 0 10rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.detail-button {
  background-color: #fff;
  color: #28a745;
  border: 1rpx solid #28a745;
}

.settle-button {
  background-color: #28a745;
  color: #fff;
}

.modal-body {
  padding: 40rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.score-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: white;
}

.current-score {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.modal-btn {
  flex: 1;
  height: 100rpx;
  border: none;
  margin: 0;
  padding: 0;
  font-size: 32rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel,
.cancel-btn {
  background: #f8f9fa;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn.confirm,
.confirm-btn {
  background: #28a745;
  color: white;
}
