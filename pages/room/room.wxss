/* room.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

.container {
  flex: 1;
  padding: 40rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

.room-info {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.room-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.room-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.invite-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qrcode-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  border: 2rpx solid #f0f0f0;
}

.qrcode-tip {
  font-size: 20rpx;
  color: #666;
  margin-top: 10rpx;
}

.share-button {
  width: 160rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #1296db, #0e7bb8);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
  padding: 0;
}

.share-button::after {
  border: none;
}

.share-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.share-text {
  font-size: 24rpx;
  color: white;
}

.players-section {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #e9ecef;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.player-count {
  font-size: 24rpx;
  color: #666;
  background: #e9ecef;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.players-table {
  background: white;
}

/* 保证表头和表格主体的列宽一致 */
.table-header,
.table-row {
  display: grid;
  grid-template-columns: 33% 33% 33%;  /* 使用百分比代替 fr，确保列宽相等 */
  border-bottom: 1rpx solid #f0f0f0;
}

/* 保证表头和表格主体的内边距一致 */
.header-cell, .table-cell {
  padding: 20rpx;  /* 保证所有单元格有相同的内边距 */
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.header-cell.player {
  justify-content: flex-start;
  position: relative;
}

.header-cell.player::before {
  content: '';
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  display: inline-block;
}

.header-cell.score {
  justify-content: center;
}

.header-cell.action {
  justify-content: center;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell.player-cell {
  justify-content: flex-start;
  padding-left: 20rpx;
}

.player-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.player-info {
  flex: 1;
  min-width: 0;
}

.player-name {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.table-cell.score-cell,
.table-cell.action-cell {
  padding-left: 20rpx;
  padding-right: 20rpx;  /* 确保操作列与得分列间距一致 */
}

.score-value {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  width: 100%;
}

/* 为操作列的按钮添加适当的宽度和样式 */
.transfer-button {
  width: 80rpx;  /* 调整按钮宽度，确保按钮不超过列宽 */
  height: 50rpx;
  background: #1296db;
  color: white;
  border-radius: 25rpx;
  font-size: 30rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.transfer-button[disabled] {
  background: #ccc;
  color: #999;
}

.transfer-button::after {
  border: none;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
}

.modal-body {
  padding: 40rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.score-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: white;
}

.current-score {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-button {
  flex: 1;
  height: 100rpx;
  border: none;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
}

.modal-button::after {
  border: none;
}

.modal-button.cancel {
  background: #f8f9fa;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal-button.confirm {
  background: #1296db;
  color: white;
}
