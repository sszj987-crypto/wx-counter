<!-- history.wxml -->
<navigation-bar title="历史结算" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="container">
  <!-- 主内容区 -->
  <view class="main-content">
    <!-- 统计信息 -->
    <view class="stats-container">
    <view class="stat-item">
      <text class="stat-label">总局数</text>
      <text class="stat-value">{{statistics.totalGames}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">胜利</text>
      <text class="stat-value">{{statistics.wins}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">失败</text>
      <text class="stat-value">{{statistics.losses}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">总得分</text>
      <text class="stat-value">{{statistics.totalScore}}</text>
    </view>
  </view>
  
  <!-- 历史记录列表 -->
  <scroll-view class="history-list" scroll-y bindscrolltolower="loadMoreData" lower-threshold="100">
    <!-- 表头 -->
    <view class="history-header">
      <view class="header-item">时间</view>
      <view class="header-item">房间号</view>
      <view class="header-item">结果</view>
      <view class="header-item">得分</view>
      <view class="header-item">详情</view>
    </view>
    
    <!-- 记录列表 -->
    <view class="history-item" wx:for="{{historySettlements}}" wx:key="_index">
      <!-- 记录行 -->
      <view class="record-row" bindtap="toggleRecordDetail" data-index="{{index}}">
        <view class="game-time">
          <text>{{item.formattedTime}}</text>
        </view>
        <view class="room-id">
          <text>{{item.roomNumber}}</text>
        </view>
        <view class="my-result">
          <text class="result-text">{{item.myResult}}</text>
        </view>
        <view class="my-score">
          <text class="score-text">{{item.myScore}}</text>
        </view>
        <view class="detail-toggle">
          <text class="toggle-icon">{{expandedRecordIndex === index ? '▲' : '▼'}}</text>
        </view>
      </view>
      
      <!-- 展开详情 -->
      <view class="record-details" wx:if="{{expandedRecordIndex === index}}">
        <view class="player-list">
          <view class="player-item" wx:for="{{item.details}}" wx:for-item="player" wx:key="playerId">
            <view class="player-info">
              <image class="player-avatar" src="{{player.avatar}}"></image>
              <text class="player-nickname">{{player.nickname}}</text>
            </view>
            <text class="player-score">{{player.score}}</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{historySettlements.length === 0}}">
      <text>暂无历史记录</text>
    </view>
    
    <!-- 加载更多指示器 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <text>加载中...</text>
    </view>
  </scroll-view>
  </view>
</view>