/* history.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

.container {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx;
}

/* 主内容区 */
.main-content {
  padding: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  color: #333;
}

.stats-container {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
}

.stat-item {
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 5rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #000;
  display: block;
}

.history-list {
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  overflow: hidden;
  height: calc(100vh - 260rpx); /* 设置scroll-view的高度，确保能滚动 */
}

.history-header {
  display: flex;
  background-color: #e0e0e0;
  font-weight: bold;
}

.header-item {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333;
}

.history-item {
  border-bottom: 1rpx solid #ddd;
}

.record-row {
  display: flex;
  align-items: center;
  height: 80rpx;
  background-color: #fff;
}

.game-time, .room-id, .my-result, .my-score, .detail-toggle {
  flex: 1;
  text-align: center;
  padding: 0 10rpx;
}

.game-time text {
  color: #333;
  font-size: 24rpx;
  display: inline-block;
  line-height: 1.4;
  vertical-align: middle;
  white-space: pre-line; /* 支持换行符显示 */
}

.room-id text {
  color: #333;
  font-size: 24rpx;
  display: inline-block;
  line-height: 1;
  vertical-align: middle;
}

.result-text {
  font-weight: bold;
  font-size: 24rpx;
  display: inline-block;
  line-height: 1;
  vertical-align: middle;
  padding: 5rpx 10rpx;
  border-radius: 5rpx;
  background-color: #4CAF50;
  color: white;
}

.score-text {
  font-weight: bold;
  font-size: 24rpx;
  display: inline-block;
  line-height: 1;
  vertical-align: middle;
  padding: 5rpx 10rpx;
  border-radius: 5rpx;
  background-color: #FFC107;
  color: black;
}

.toggle-icon {
  font-size: 20rpx;
  color: #666;
}

.record-details {
  background-color: #f9f9f9;
  padding: 20rpx;
}

.detail-header {
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.player-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.player-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.player-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1; /* 让player-info占据更多空间 */
  min-width: 0; /* 允许flex子项收缩 */
}

.player-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.player-nickname {
  color: #333;
  font-size: 24rpx;
  flex: 1;
  /* 防止昵称换行 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  /* 限制昵称区域的最大宽度，增加可用空间 */
  max-width: calc(100% - 60rpx); /* 减去头像40rpx + gap 10rpx + 一些间距 */
}

.player-score {
  color: #333;
  font-size: 24rpx;
  font-weight: bold;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}