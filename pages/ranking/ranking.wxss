/* ranking.wxss */
page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
}

.container {
  flex: 1;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 排序标签页 */
.sort-tabs {
  display: flex;
  background-color: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.sort-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 6rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.sort-tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-weight: bold;
}

/* 排行榜列表 */
.ranking-list {
  background-color: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  height: calc(100vh - 260rpx); /* 设置scroll-view的高度，确保能滚动 */
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-item.top-1 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: white;
}

.ranking-item.top-2 {
  background: linear-gradient(135deg, #C0C0C0, #A9A9A9);
  color: white;
}

.ranking-item.top-3 {
  background: linear-gradient(135deg, #CD7F32, #B8860B);
  color: white;
}

/* 排名 */
.rank-number {
  width: 50rpx;
  text-align: center;
  margin-right: 12rpx;
}

.rank-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.top-1 .rank-text,
.top-2 .rank-text,
.top-3 .rank-text {
  color: white;
}

/* 用户信息 */
.user-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 2rpx solid #ddd;
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
  color: #333;
}

.top-1 .user-name,
.top-2 .user-name,
.top-3 .user-name {
  color: white;
}

.user-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.stat-item {
  font-size: 20rpx;
  color: #666;
  padding: 2rpx 4rpx;
  background-color: #f5f5f5;
  border-radius: 4rpx;
}

.top-1 .stat-item,
.top-2 .stat-item,
.top-3 .stat-item {
  background-color: rgba(255, 255, 255, 0.2);
  color: white;
}

/* 统计数据 */
.stats-info {
  text-align: center;
  min-width: 90rpx;
}

.stat-value {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 2rpx;
  color: #333;
}

.win-rate {
  color: #667eea;
}

.net-score.positive {
  color: #ff6b6b;
}

.net-score.negative {
  color: #4ecdc4;
}

.top-1 .stat-value,
.top-2 .stat-value,
.top-3 .stat-value {
  color: white;
}

.stat-label {
  font-size: 20rpx;
  color: #666;
}

.top-1 .stat-label,
.top-2 .stat-label,
.top-3 .stat-label {
  color: rgba(255, 255, 255, 0.8);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-text {
  font-size: 28rpx;
}